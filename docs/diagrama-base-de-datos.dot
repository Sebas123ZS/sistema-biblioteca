digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.0, pad=0.3, bgcolor="white", dpi=200];
node [shape=plain];
edge [color="#5B6B82", penwidth=1.4, dir=both, arrowtail=teetee, arrowhead=crowodot, fontname="Helvetica", fontsize=10, fontcolor="#1D6FE0"];
categorias [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1D6FE0"><TR><TD COLSPAN="3" BGCOLOR="#0B1F3A"><FONT FACE="Helvetica" COLOR="white" POINT-SIZE="13"><B>categorias</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">nombre</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(60)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>UQ</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">descripcion</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR></TABLE>>];
autores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1D6FE0"><TR><TD COLSPAN="3" BGCOLOR="#0B1F3A"><FONT FACE="Helvetica" COLOR="white" POINT-SIZE="13"><B>autores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombres" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">nombres</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="apellidos" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">apellidos</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nacionalidad" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">nacionalidad</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(60)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="biografia" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">biografia</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(1000)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR></TABLE>>];
libros [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1D6FE0"><TR><TD COLSPAN="3" BGCOLOR="#0B1F3A"><FONT FACE="Helvetica" COLOR="white" POINT-SIZE="13"><B>libros</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="isbn" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">isbn</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>UQ</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">titulo</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(200)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="editorial" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">editorial</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="anio_publicacion" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">anio_publicacion</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria_id" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">categoria_id</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad_total" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">cantidad_total</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad_disponible" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">cantidad_disponible</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="portada_url" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">portada_url</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(500)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">activo</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">fecha_registro</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">DATETIME</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">version</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR></TABLE>>];
libro_autor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1D6FE0"><TR><TD COLSPAN="3" BGCOLOR="#0B1F3A"><FONT FACE="Helvetica" COLOR="white" POINT-SIZE="13"><B>libro_autor</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="libro_id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>libro_id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK, FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="autor_id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>autor_id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK, FK</B></FONT></TD></TR></TABLE>>];
usuarios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1D6FE0"><TR><TD COLSPAN="3" BGCOLOR="#0B1F3A"><FONT FACE="Helvetica" COLOR="white" POINT-SIZE="13"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombres" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">nombres</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="apellidos" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">apellidos</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="documento" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">documento</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(15)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>UQ</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correo" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">correo</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>UQ</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">telefono</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(15)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">direccion</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(200)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">username</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>UQ</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">password</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">rol</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">estado</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">fecha_registro</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">DATETIME</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR></TABLE>>];
prestamos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1D6FE0"><TR><TD COLSPAN="3" BGCOLOR="#0B1F3A"><FONT FACE="Helvetica" COLOR="white" POINT-SIZE="13"><B>prestamos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="libro_id" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">libro_id</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reserva_id" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">reserva_id</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>FK, UQ</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_prestamo" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">fecha_prestamo</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">DATE</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_vencimiento" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">fecha_vencimiento</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">DATE</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">estado</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR></TABLE>>];
devoluciones [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1D6FE0"><TR><TD COLSPAN="3" BGCOLOR="#0B1F3A"><FONT FACE="Helvetica" COLOR="white" POINT-SIZE="13"><B>devoluciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prestamo_id" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">prestamo_id</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>FK, UQ</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_devolucion" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">fecha_devolucion</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">DATE</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dias_retraso" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">dias_retraso</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_libro" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">estado_libro</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observaciones" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">observaciones</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(500)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR></TABLE>>];
reservas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1D6FE0"><TR><TD COLSPAN="3" BGCOLOR="#0B1F3A"><FONT FACE="Helvetica" COLOR="white" POINT-SIZE="13"><B>reservas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" BGCOLOR="#EAF2FD"><FONT FACE="Helvetica" POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="libro_id" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">libro_id</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_reserva" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">fecha_reserva</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">DATETIME</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_disponible" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">fecha_disponible</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">DATE</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_expiracion" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">fecha_expiracion</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">DATE</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado" BGCOLOR="#FFFFFF"><FONT FACE="Helvetica" POINT-SIZE="11">estado</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#555555">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#1D6FE0"> </FONT></TD></TR></TABLE>>];
categorias -> libros [label="categoria_id"];
libros -> libro_autor [label="libro_id"];
autores -> libro_autor [label="autor_id"];
usuarios -> prestamos [label="usuario_id"];
libros -> prestamos [label="libro_id"];
usuarios -> reservas [label="usuario_id"];
libros -> reservas [label="libro_id"];
reservas -> prestamos [label="reserva_id (0..1)", arrowtail=teeodot, arrowhead=teeodot];
prestamos -> devoluciones [label="prestamo_id (1:1)", arrowtail=teetee, arrowhead=teeodot];
{rank=same; categorias; autores; usuarios;}
{rank=same; libros;}
{rank=same; libro_autor; reservas;}
}
